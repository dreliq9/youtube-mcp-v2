{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dreliq9/youtube-mcp-v2/bench/manifest.schema.json",
  "title": "YouTube-MCP Bench Manifest",
  "description": "Normative schema for benchmark manifests. Revision 0.1 manifests remain valid: every field added for 0.2 is optional. Manifests store IDs, annotations, and hashes only, never third-party video or transcript payloads.",
  "type": "object",
  "required": ["benchmark_version", "adapter", "cases"],
  "properties": {
    "benchmark_version": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1, "description": "Default adapter; the runner's --adapter flag overrides it."},
    "description": {"type": "string"},
    "revision_notes": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "window": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "case": {
      "type": "object",
      "required": ["id", "suite", "task", "mode", "input", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "suite": {
          "type": "string",
          "enum": [
            "protocol",
            "url",
            "metadata",
            "transcript",
            "validation",
            "long_context",
            "corpus",
            "semantic",
            "visual",
            "cross_modal",
            "fault_tolerance"
          ]
        },
        "task": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["deterministic", "live"]},
        "input": {"type": "object"},
        "expected": {"type": "object"},
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$",
          "description": "Real YouTube ID for live cases, or a synthetic bnch* ID for fixtures."
        },
        "media_strata": {"type": "array", "items": {"type": "string"}},
        "domain_strata": {"type": "array", "items": {"type": "string"}},
        "fixture": {
          "type": "object",
          "description": "Deterministic upstream behaviour; see bench/fixtures/upstream.py.",
          "properties": {
            "native": {"type": "object"},
            "native_malformed": {"type": "boolean"},
            "ytdlp": {"type": "object"},
            "watch_page": {"type": "object"},
            "data_api": {"type": "object"},
            "cache": {"type": "object"}
          },
          "additionalProperties": false
        },
        "scoring": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["subset", "metadata_fields", "provenance", "temporal_window", "fault"]
            },
            "params": {
              "type": "object",
              "properties": {
                "windows": {"type": "array", "items": {"$ref": "#/$defs/window"}, "minItems": 1},
                "tolerance_s": {"type": "number", "minimum": 0},
                "k": {"type": "integer", "minimum": 1},
                "min_completeness": {"type": "number", "minimum": 0, "maximum": 1},
                "expect_error_code": {"type": "string"},
                "expect_provider": {"type": "string"}
              }
            }
          },
          "additionalProperties": false
        },
        "known_issue": {
          "type": "object",
          "description": "Case documents a known gap: a failure is reported as xfail, a pass as xpass.",
          "required": ["reason"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "reference": {"type": "string"}
          },
          "additionalProperties": false
        },
        "tags": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
