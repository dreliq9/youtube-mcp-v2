{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dreliq9/youtube-mcp-v2/bench/manifest.schema.json",
  "title": "YouTube-MCP Bench Manifest",
  "type": "object",
  "required": ["benchmark_version", "adapter", "cases"],
  "properties": {
    "benchmark_version": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "suite", "task", "mode", "input", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "suite": {
            "type": "string",
            "enum": [
              "protocol",
              "url",
              "metadata",
              "transcript",
              "validation",
              "corpus",
              "semantic",
              "visual",
              "cross_modal",
              "fault_tolerance"
            ]
          },
          "task": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "enum": ["deterministic", "live"]},
          "input": {"type": "object"},
          "expected": {"type": "object"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
