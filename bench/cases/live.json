{
  "benchmark_version": "0.2-live",
  "adapter": "youtube_mcp_v2",
  "description": "Opt-in live-network cases (python bench/run.py --mode live). Only public video IDs, expected metadata annotations, and human-verified evidence windows are stored; no video or transcript payloads. Never run in PR CI.",
  "revision_notes": "Annotations verified against live YouTube on 2026-09-29. Upstream titles and captions can change; failures here are reported, not gated. The live set is small and not yet domain-balanced.",
  "cases": [
    {
      "id": "live-protocol-launch-and-list",
      "suite": "protocol",
      "task": "protocol_probe",
      "mode": "live",
      "input": {},
      "expected": {
        "launched": true,
        "documented_tools_present": true,
        "schemas": {
          "all_object": true
        },
        "unknown_tool": {
          "survived": true
        }
      },
      "domain_strata": [
        "n/a"
      ],
      "media_strata": [
        "protocol"
      ],
      "notes": "Cold launch with the adapter's default install command (may include a network install)."
    },
    {
      "id": "live-protocol-invalid-url-structured",
      "suite": "protocol",
      "task": "protocol_probe",
      "mode": "live",
      "input": {},
      "expected": {
        "invalid_input": {
          "handled": true,
          "machine_code": {
            "$present": true
          }
        }
      },
      "domain_strata": [
        "n/a"
      ],
      "media_strata": [
        "protocol"
      ]
    },
    {
      "id": "live-meta-zoo",
      "suite": "metadata",
      "task": "live_metadata",
      "mode": "live",
      "input": {
        "video_id": "jNQXAC9IVRw"
      },
      "expected": {
        "ok": true,
        "title": "Me at the zoo",
        "channel": "jawed",
        "duration_s": {
          "$approx": 19,
          "$tol": 1
        },
        "has_transcript": true,
        "available_caption_langs": {
          "$contains": [
            "en"
          ]
        }
      },
      "scoring": {
        "method": "metadata_fields"
      },
      "video_id": "jNQXAC9IVRw",
      "domain_strata": [
        "personal-vlog"
      ],
      "media_strata": [
        "short",
        "manual-captions",
        "multilingual"
      ]
    },
