{
  "benchmark_version": "0.2",
  "adapter": "youtube_mcp_v2",
  "description": "Core deterministic suites: installation/protocol over stdio, metadata, transcript provenance and temporal evidence, long-context delivery, and fault tolerance against scripted upstream failures. All transcripts and watch pages are benchmark-owned synthetic fixtures (bench/fixtures/synthetic.py); only their SHA-256 hashes appear here.",
  "revision_notes": "0.2 adds protocol, metadata, long_context and fault_tolerance suites, scripted upstream fixtures, metric scorers (field accuracy, provenance completeness, temporal hit/MRR, survival/structured-error/fallback), and known_issue (xfail) cases. Revision 0.1 (deterministic.json) is unchanged.",
  "cases": [
    {
      "id": "proto-stdio-initialize",
      "suite": "protocol",
      "task": "protocol_probe",
      "mode": "deterministic",
      "input": {},
      "expected": {
        "launched": true,
        "protocol_version": {
          "$type": "string"
        },
        "server_name": {
          "$present": true
        },
        "init_ms": {
          "$lte": 15000
        }
      },
      "notes": "Spawns the server over stdio with the MCP SDK client and completes initialize.",
      "domain_strata": [
        "n/a"
      ],
      "media_strata": [
        "protocol"
      ],
      "tags": [
        "stdio"
      ]
    },
